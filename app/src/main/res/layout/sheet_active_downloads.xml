<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
    <View android:layout_width="32dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="?attr/colorOutline" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="@string/downloads" android:textAppearance="@style/TextAppearance.KDownloader.TitleLarge" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/active_downloads_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
</LinearLayout>
