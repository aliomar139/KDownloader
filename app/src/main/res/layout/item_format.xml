<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.KDownloader.Card.Format" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="72dp" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:id="@+id/format_icon" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_format_icon" android:padding="10dp" android:importantForAccessibility="no" app:tint="?attr/colorOnPrimaryContainer" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/format_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.KDownloader.TitleMedium" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/format_badge" android:layout_width="wrap_content" android:layout_height="24dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_format_badge" android:gravity="center"
                    android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/best" android:textAppearance="@style/TextAppearance.KDownloader.LabelMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/format_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.KDownloader.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/format_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" app:indicatorColor="?attr/colorPrimary" />
        </LinearLayout>
        <ImageButton android:id="@+id/format_action" style="@style/Widget.KDownloader.IconButton" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:backgroundTint="?attr/colorPrimary" android:contentDescription="@string/download"
            android:src="@drawable/ic_download" app:tint="?attr/colorOnPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
