<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_state_icon">
        <ImageView android:id="@+id/state_icon" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:importantForAccessibility="no" app:tint="?attr/brandAccent" />
    </FrameLayout>
    <TextView android:id="@+id/state_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center" android:maxLines="2"
        android:textAppearance="@style/TextAppearance.KDownloader.TitleMedium" />
    <TextView android:id="@+id/state_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:maxLines="4"
        android:maxWidth="320dp"
        android:textAppearance="@style/TextAppearance.KDownloader.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.button.MaterialButton android:id="@+id/state_action"
        style="@style/Widget.KDownloader.Button.Tonal" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:visibility="gone" />
</merge>
