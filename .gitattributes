* text=auto

*.java text eol=lf linguist-detectable=true
*.gradle text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Bundled third-party and generated/runtime assets should not affect language statistics.
/app/src/main/res/raw/ytdlp binary linguist-vendored
/app/src/main/res/font/*.ttf binary linguist-vendored
/gradlew text eol=lf linguist-generated
/gradlew.bat text eol=crlf linguist-generated
/gradle/wrapper/gradle-wrapper.jar binary linguist-vendored
